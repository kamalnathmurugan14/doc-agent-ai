    "/agent/approve/{action_id}": {
      "post": {
        "summary": "Approve",
        "description": "Approve or reject a pending action. The paused run resumes; a rejection is fed back to the agent as feedback.",
        "operationId": "approve_agent_approve__action_id__post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
