    "/fs/preview": {
      "get": {
        "summary": "Preview",
        "description": "First `chars` characters of a document (used by the Label page).",
        "operationId": "preview_fs_preview_get",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "chars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3000,
              "title": "Chars"
            }
          }
        ],
        "responses": {
          "200": {
