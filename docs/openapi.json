      }
    },
    "/agent/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_agent_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
