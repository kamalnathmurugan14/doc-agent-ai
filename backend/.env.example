# Folder with YOUR documents (pdf, docx, txt, md). The agent can only read and change files inside it.
# Windows example: C:/Users/you/Documents/docs
DOCS_ROOT=./sample_docs
# SQLite (runs, steps, approvals, checkpoints) lives here (git-ignored)
DATA_DIR=./data
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
# Ollama (run `ollama serve`, then `ollama pull llama3.1:8b`). Use a model that follows JSON formats well.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Guardrails: maximum agent steps, seconds per LLM/tool call, seconds per run (time waiting for you does not count)
AGENT_MAX_STEPS=12
AGENT_STEP_TIMEOUT_S=60
AGENT_RUN_TIMEOUT_S=600
# Which kinds of tools need your approval: any of write,move,rename (tools: write_report=write, move_file=move, rename_file=rename)
REQUIRE_APPROVAL=write,move,rename
# Seconds a pending approval stays valid before it expires (treated as a rejection)
APPROVAL_TIMEOUT_S=3600
# Optional adapters to the other projects (leave empty to use the built-in fallbacks)
RAG_SERVICE_URL=
CLASSIFIER_SERVICE_URL=
# Where write_report saves reports (inside DOCS_ROOT; files are never overwritten)
REPORTS_DIR=_reports
# How many previous task summaries are shown to the agent as memory (0 = off)
MEMORY_RUNS=3
# Tool output sent back to the model is truncated to this many characters
MAX_TOOL_OUTPUT_CHARS=4000
CORS_ORIGINS=http://localhost:5173
